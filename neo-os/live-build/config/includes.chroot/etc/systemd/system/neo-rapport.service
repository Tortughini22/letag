# Néo OS — diagnostic : avec l'option de démarrage « neo.rapport », écrit
# la mesure mémoire (neo-mesure) sur le port série et dans le journal,
# 4 minutes après l'arrivée sur le bureau. Sert aux tests en machine virtuelle
# et peut servir sur le HP (lire ensuite : journalctl -u neo-rapport).
[Unit]
Description=Néo OS — rapport de mesure (option neo.rapport)
ConditionKernelCommandLine=neo.rapport
After=graphical.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep 240; { echo NEO-RAPPORT-DEBUT; /usr/local/bin/neo-mesure; echo NEO-RAPPORT-FIN; } | tee /dev/ttyS0'

[Install]
WantedBy=graphical.target
