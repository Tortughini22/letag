# Néo OS — vérifie au démarrage les caches de polices et d'icônes, et les
# reconstruit s'ils manquent ou sont périmés (rapide quand ils sont valides).
# Un cache absent coûte des dizaines de Mo de RAM par application GTK.
[Unit]
Description=Néo OS — caches de polices et d'icônes
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/bin/fc-cache --system-only
ExecStart=/bin/sh -c 'for t in /usr/share/icons/*/; do [ -f "$${t}index.theme" ] && [ ! -f "$${t}icon-theme.cache" ] && gtk-update-icon-cache --quiet "$$t"; done; true'

[Install]
WantedBy=multi-user.target
