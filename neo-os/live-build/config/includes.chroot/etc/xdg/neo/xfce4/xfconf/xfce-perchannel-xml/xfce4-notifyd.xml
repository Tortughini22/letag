<?xml version="1.0" encoding="UTF-8"?>
<!-- Néo OS : notifications en bas à droite (comme Windows), thème Néo. -->
<channel name="xfce4-notifyd" version="1.0">
  <property name="theme" type="string" value="Neo-Clair"/>
  <property name="notify-location" type="string" value="bottom-right"/>
  <property name="expire-timeout" type="int" value="7"/>
  <property name="initial-opacity" type="double" value="1"/>
  <property name="do-fadeout" type="bool" value="true"/>
  <property name="do-slideout" type="bool" value="false"/>
  <property name="show-text-with-gauge" type="bool" value="true"/>
</channel>
