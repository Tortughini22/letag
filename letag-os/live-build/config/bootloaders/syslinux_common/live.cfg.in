label live
	menu label ^Essayer Letag OS
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-sans-accel
	menu label Essayer - affichage ^sans acceleration (nouveau.noaccel)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nouveau.noaccel=1

label live-secours
	menu label Essayer - affichage de ^secours (nomodeset, VESA)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nomodeset

label live-toram
	menu label Essayer - copie en ^memoire vive (toram, lent au depart)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ toram

label live-failsafe
	menu label Mode sans ^echec (pilotes minimaux)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@
