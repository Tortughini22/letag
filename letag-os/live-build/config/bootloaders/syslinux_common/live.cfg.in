label live
	menu label ^Essayer Letag OS
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-sans-accel
	menu label Essayer - ^sans acceleration graphique
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nouveau.noaccel=1

label live-secours
	menu label Essayer - ^affichage de secours (VESA)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ nomodeset

label live-toram
	menu label Essayer - charge en ^memoire vive (toram)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ toram

label live-failsafe
	menu label Mode sans ^echec
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@
