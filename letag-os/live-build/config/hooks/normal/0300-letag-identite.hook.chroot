#!/bin/sh
# Letag OS — nom du système. /usr/lib/os-release est « détourné » (dpkg-divert)
# pour survivre aux mises à jour de base-files ; ID=debian est conservé afin que
# apt, unattended-upgrades et les outils Debian fonctionnent sans changement.
set -e
if ! dpkg-divert --list /usr/lib/os-release | grep -q letag; then
	dpkg-divert --package letag --divert /usr/lib/os-release.debian --rename --add /usr/lib/os-release
fi
. /usr/lib/os-release.debian
cat > /usr/lib/os-release <<EOT
PRETTY_NAME="Letag OS 1.0 (base Debian ${VERSION_ID})"
NAME="Letag OS"
VERSION_ID="${VERSION_ID}"
VERSION="1.0 (base Debian ${VERSION_ID} « ${VERSION_CODENAME} »)"
VERSION_CODENAME=${VERSION_CODENAME}
ID=debian
HOME_URL="https://www.debian.org/"
SUPPORT_URL="https://www.debian.org/support"
BUG_REPORT_URL="https://bugs.debian.org/"
EOT

# /etc/os-release (fichier distinct sous Debian 13, détourné temporairement par
# live-build pendant la construction) est remplacé au démarrage par un lien vers
# /usr/lib/os-release : voir /etc/tmpfiles.d/letag-os-release.conf.

# Fond d'écran par défaut de XFCE (utilisé quand l'écran n'a pas de réglage
# propre, par exemple en mode secours sans RANDR) : remplacé par le fond Letag.
if [ -f /usr/share/backgrounds/xfce/xfce-x.svg ] && ! dpkg-divert --list /usr/share/backgrounds/xfce/xfce-x.svg | grep -q letag; then
	dpkg-divert --package letag --divert /usr/share/backgrounds/xfce/xfce-x.svg.xfce --rename --add /usr/share/backgrounds/xfce/xfce-x.svg
fi
ln -sf ../letag/fond-clair.svg /usr/share/backgrounds/xfce/xfce-x.svg
