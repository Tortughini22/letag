#!/bin/sh
# Letag OS — services : on garde le nécessaire, on retire ce qui ralentit.
set -e
# Ne pas attendre le réseau au démarrage (rien ici n'en dépend).
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
# Services utiles, activés explicitement.
for s in earlyoom.service unattended-upgrades.service fstrim.timer apt-daily.timer apt-daily-upgrade.timer; do
	systemctl enable "$s" 2>/dev/null || true
done
# smartd : surveillance du disque dur, contrôle toutes les 30 min seulement.
if [ -f /etc/default/smartmontools ]; then
	sed -i 's/^#\?smartd_opts=.*/smartd_opts="--interval=1800"/' /etc/default/smartmontools
fi
# Navigateur et terminal par défaut.
update-alternatives --set x-www-browser /usr/bin/firefox-esr 2>/dev/null || true
update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper 2>/dev/null || true
systemctl enable letag-rapport.service
