# Letag OS — diagnostic : avec l'option de démarrage « letag.rapport », écrit
# la mesure mémoire (letag-mesure) sur le port série et dans le journal,
# 4 minutes après l'arrivée sur le bureau. Sert aux tests en machine virtuelle
# et peut servir sur le HP (lire ensuite : journalctl -u letag-rapport).
[Unit]
Description=Letag OS — rapport de mesure (option letag.rapport)
ConditionKernelCommandLine=letag.rapport
After=graphical.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep 240; { echo LETAG-RAPPORT-DEBUT; /usr/local/bin/letag-mesure; echo LETAG-RAPPORT-FIN; } | tee /dev/ttyS0'

[Install]
WantedBy=graphical.target
