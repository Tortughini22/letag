<?xml version="1.0" encoding="UTF-8"?>
<!-- Letag OS : une barre des tâches en bas de l'écran.
     [menu + recherche] [applications épinglées / fenêtres] ... [zone de
     notification] [son] [horloge] [session] -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="false"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=10;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="40"/>
      <property name="icon-size" type="uint" value="24"/>
      <property name="enable-struts" type="bool" value="true"/>
      <!-- Fond uni opaque : sans compositeur, un fond « thème » (transparent)
           rend invisibles les icônes de la zone de notification. -->
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.937"/>
        <value type="double" value="0.937"/>
        <value type="double" value="0.929"/>
        <value type="double" value="1"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- Menu d'applications avec recherche (touche Super ou clic) -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="letag-menu"/>
      <property name="show-button-title" type="bool" value="false"/>
      <property name="button-title" type="string" value="Applications"/>
      <property name="view-mode" type="int" value="1"/>
      <property name="launcher-show-description" type="bool" value="false"/>
      <property name="launcher-icon-size" type="int" value="3"/>
      <property name="category-icon-size" type="int" value="2"/>
      <property name="menu-width" type="int" value="560"/>
      <property name="menu-height" type="int" value="520"/>
      <property name="menu-opacity" type="int" value="100"/>
      <property name="position-search-alternate" type="bool" value="true"/>
      <property name="position-commands-alternate" type="bool" value="true"/>
      <property name="position-profile-alternate" type="bool" value="true"/>
      <property name="recent-items-max" type="int" value="8"/>
      <property name="hover-switch-category" type="bool" value="false"/>
      <property name="show-command-menueditor" type="bool" value="false"/>
      <property name="show-command-settings" type="bool" value="true"/>
      <property name="show-command-lockscreen" type="bool" value="true"/>
      <property name="show-command-logoutuser" type="bool" value="true"/>
      <property name="command-settings" type="string" value="xfce4-settings-manager"/>
      <property name="favorites" type="array">
        <value type="string" value="firefox-esr.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="geany.desktop"/>
        <value type="string" value="libreoffice-writer.desktop"/>
        <value type="string" value="libreoffice-calc.desktop"/>
        <value type="string" value="io.github.celluloid_player.Celluloid.desktop"/>
        <value type="string" value="letag-centre.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <!-- Applications épinglées + fenêtres ouvertes -->
    <property name="plugin-3" type="string" value="docklike"/>
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-5" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
    <property name="plugin-6" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
    </property>
    <property name="plugin-7" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%H:%M"/>
      <property name="digital-time-font" type="string" value="Inter Semi-Bold 10"/>
      <property name="tooltip-format" type="string" value="%A %e %B %Y"/>
    </property>
    <property name="plugin-8" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-9" type="string" value="actions">
      <property name="appearance" type="uint" value="0"/>
      <property name="items" type="array">
        <value type="string" value="+lock-screen"/>
        <value type="string" value="+separator"/>
        <value type="string" value="+logout"/>
        <value type="string" value="+restart"/>
        <value type="string" value="+shutdown"/>
        <value type="string" value="-switch-user"/>
        <value type="string" value="-suspend"/>
        <value type="string" value="-hibernate"/>
        <value type="string" value="-hybrid-sleep"/>
        <value type="string" value="-logout-dialog"/>
      </property>
    </property>
  </property>
</channel>
