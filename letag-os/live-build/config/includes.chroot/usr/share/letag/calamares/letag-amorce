#!/bin/sh
# Letag OS / Calamares — prépare GRUB dans le système cible ($1 = racine).
# BIOS (cas du HP Z200) : grub-pc est déjà présent, aucun accès réseau requis.
# UEFI : grub-install fonctionne hors ligne (grub-efi-amd64-bin présent) ; si
# Internet est disponible, on passe au paquet grub-efi-amd64 pour que les
# mises à jour de GRUB suivent le bon mode d'amorçage.
CIBLE="$1"
[ -d "$CIBLE" ] || exit 1
if [ -d /sys/firmware/efi/efivars ]; then
	echo "Amorçage UEFI détecté."
	if chroot "$CIBLE" apt-get update >/dev/null 2>&1 &&
	   DEBIAN_FRONTEND=noninteractive chroot "$CIBLE" apt-get -y install grub-efi-amd64; then
		echo "grub-efi-amd64 installé."
	else
		echo "Pas d'accès Internet : après l'installation, lancez « sudo apt install grub-efi-amd64 »."
	fi
else
	echo "Amorçage BIOS détecté : grub-pc déjà présent."
fi
exit 0
