#!/bin/sh
# letag-theme — bascule entre le thème clair et le thème sombre de Letag OS.
# Usage : letag-theme clair | sombre | basculer | appliquer | etat
set -eu

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/letag"
mkdir -p "$CONF"

actuel() { cat "$CONF/theme" 2>/dev/null || echo clair; }

case "${1:-appliquer}" in
	clair|sombre) choix="$1" ;;
	basculer) if [ "$(actuel)" = clair ]; then choix=sombre; else choix=clair; fi ;;
	appliquer) choix="$(actuel)" ;;
	etat) actuel; exit 0 ;;
	*) echo "Usage : $(basename "$0") clair|sombre|basculer|appliquer|etat" >&2; exit 2 ;;
esac

if [ "$choix" = sombre ]; then
	gtk=Letag-Sombre; icones=Letag-Sombre; sombre=true
	fond=/usr/share/letag/fonds/letag-sombre.png
else
	gtk=Letag-Clair; icones=Letag; sombre=false
	fond=/usr/share/letag/fonds/letag-clair.png
fi

regler() { # canal propriété type valeur
	xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4" 2>/dev/null || true
}

regler xsettings /Net/ThemeName string "$gtk"
regler xsettings /Net/IconThemeName string "$icones"
regler xfwm4 /general/theme string "$gtk"
regler xfce4-panel /panels/dark-mode bool "$sombre"
regler xfce4-terminal /color-use-theme bool true

# Fond d'écran sur chaque écran branché (les noms dépendent de la carte
# graphique : DVI-I-1, DP-1, Virtual-1…).
if command -v xrandr >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
	for ecran in $(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
		base="/backdrop/screen0/monitor${ecran}/workspace0"
		regler xfce4-desktop "$base/last-image" string "$fond"
		regler xfce4-desktop "$base/image-style" int 5
		regler xfce4-desktop "$base/color-style" int 0
	done
fi

echo "$choix" > "$CONF/theme"
