#!/bin/sh
# letag-session — lancé à chaque ouverture de session XFCE (autostart).
# Première fois : raccourcis clavier et réglages du terminal. À chaque fois :
# application du thème (fond d'écran sur les écrans présents).
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/letag"
mkdir -p "$CONF"

raccourci() { xfconf-query -c xfce4-keyboard-shortcuts -p "$1" -n -t string -s "$2" 2>/dev/null; }

if [ ! -f "$CONF/initialise" ]; then
	# Touche Super seule : menu des applications (avec recherche).
	raccourci "/commands/custom/Super_L" "xfce4-popup-whiskermenu"
	raccourci "/commands/custom/<Super>e" "thunar"
	raccourci "/commands/custom/<Super>t" "xfce4-terminal"
	raccourci "/commands/custom/<Super>l" "xflock4"
	raccourci "/commands/custom/<Super>f" "catfish"
	raccourci "/commands/custom/<Super>i" "letag-centre"
	raccourci "/xfwm4/custom/<Super>d" "show_desktop_key"
	xfconf-query -c xfce4-terminal -p /font-name -n -t string -s "DejaVu Sans Mono 11" 2>/dev/null
	xfconf-query -c xfce4-terminal -p /misc-menubar-default -n -t bool -s false 2>/dev/null
	xfconf-query -c xfce4-terminal -p /scrolling-lines -n -t uint -s 5000 2>/dev/null
	touch "$CONF/initialise"
fi

letag-theme appliquer

# Session live : pas de verrouillage ni de mise en veille de l'écran (une
# installation dure plusieurs minutes et le mot de passe « live » n'est pas
# connu de tous), et icône « Installer Letag OS » sur le bureau.
if [ -d /run/live/medium ]; then
	xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -n -t bool -s false 2>/dev/null
	xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/blank-on-ac -n -t int -s 0 2>/dev/null
	xfconf-query -c xfce4-session -p /shutdown/LockScreen -n -t bool -s false 2>/dev/null
	xset s off -dpms 2>/dev/null
	# light-locker peut démarrer après ce script : on l'arrête un peu plus tard.
	(sleep 30; pkill -u "$(id -u)" -x light-locker) >/dev/null 2>&1 &
fi
if [ -d /run/live/medium ] && [ -x /usr/local/bin/letag-installer ]; then
	bureau="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
	mkdir -p "$bureau"
	icone="$bureau/letag-installer.desktop"
	if [ ! -f "$icone" ]; then
		cp /usr/share/applications/letag-installer.desktop "$icone"
		chmod +x "$icone"
		gio set --type=string "$icone" metadata::xfce-exe-checksum \
			"$(sha256sum "$icone" | cut -d' ' -f1)" 2>/dev/null || true
	fi
fi
exit 0
