#!/usr/bin/python3
"""Centre Letag — réglages propres à Letag OS (thème, effets, affichage,
mises à jour, mesure mémoire). Les réglages généraux restent dans le
Gestionnaire de paramètres XFCE, accessible depuis ce panneau."""
import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

LIVE = os.path.isdir("/run/live/medium")
MODES_AFFICHAGE = [
    ("auto", "Automatique — pilote nouveau accéléré (recommandé)"),
    ("logiciel", "OpenGL logiciel — si les applications 3D ou Firefox plantent"),
    ("sans-accel", "Sans accélération — si l'affichage se fige ou clignote"),
    ("secours", "Secours (nomodeset) — si l'écran reste noir"),
]


def sortie(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def lancer(cmd):
    try:
        subprocess.Popen(cmd)
    except OSError as e:
        print("letag-centre :", e)


def info_materiel():
    cpu = "?"
    try:
        with open("/proc/cpuinfo") as f:
            for ligne in f:
                if ligne.startswith("model name"):
                    cpu = " ".join(ligne.split(":", 1)[1].split())
                    break
    except OSError:
        pass
    ram = 0
    try:
        with open("/proc/meminfo") as f:
            ram = int(f.readline().split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    gpu = ", ".join(l.split(": ", 1)[-1] for l in sortie(["lspci"]).splitlines()
                    if "VGA" in l or "3D controller" in l) or "?"
    pilote = "nouveau" if os.path.isdir("/sys/module/nouveau") else "autre / secours"
    return cpu, ram, gpu, pilote


class Centre(Gtk.Window):
    def __init__(self):
        super().__init__(title="Centre Letag")
        self.set_default_size(620, 640)
        self.set_icon_name("letag-centre")
        self.set_position(Gtk.WindowPosition.CENTER)

        defil = Gtk.ScrolledWindow()
        defil.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(defil)
        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        for cote in ("top", "bottom", "start", "end"):
            getattr(boite, "set_margin_" + cote)(24)
        defil.add(boite)

        titre = Gtk.Label(xalign=0)
        titre.set_markup("<span size='x-large' weight='bold'>Centre Letag</span>")
        boite.pack_start(titre, False, False, 0)

        # --- Apparence ---------------------------------------------------
        cadre = self.section(boite, "Apparence")
        ligne = Gtk.Box(spacing=12)
        self.clair = Gtk.RadioButton.new_with_label(None, "Thème clair")
        self.sombre = Gtk.RadioButton.new_with_label_from_widget(self.clair, "Thème sombre")
        (self.sombre if sortie(["letag-theme", "etat"]) == "sombre" else self.clair).set_active(True)
        self.clair.connect("toggled", self.changer_theme)
        ligne.pack_start(self.clair, False, False, 0)
        ligne.pack_start(self.sombre, False, False, 0)
        cadre.pack_start(ligne, False, False, 0)

        # --- Effets visuels ------------------------------------------------
        cadre = self.section(boite, "Effets visuels")
        self.minimal = Gtk.RadioButton.new_with_label(
            None, "Minimal — aucune composition ni animation (recommandé)")
        self.equilibre = Gtk.RadioButton.new_with_label_from_widget(
            self.minimal, "Équilibré — ombres sous les fenêtres (composition légère)")
        (self.equilibre if sortie(["letag-effets", "etat"]) == "equilibre" else self.minimal).set_active(True)
        self.minimal.connect("toggled", self.changer_effets)
        cadre.pack_start(self.minimal, False, False, 0)
        cadre.pack_start(self.equilibre, False, False, 0)
        cadre.pack_start(self.note("Si l'image se déchire ou saccade en mode Équilibré, revenez à Minimal."),
                         False, False, 0)

        # --- Affichage -----------------------------------------------------
        cadre = self.section(boite, "Pilote d'affichage")
        self.mode = Gtk.ComboBoxText()
        actuel = sortie(["/usr/local/bin/letag-graphique", "etat"]) or "auto"
        for i, (cle, texte) in enumerate(MODES_AFFICHAGE):
            self.mode.append(cle, texte)
            if cle == actuel:
                self.mode.set_active(i)
        ligne = Gtk.Box(spacing=8)
        ligne.pack_start(self.mode, True, True, 0)
        bouton = Gtk.Button(label="Appliquer")
        bouton.connect("clicked", self.changer_affichage)
        ligne.pack_start(bouton, False, False, 0)
        cadre.pack_start(ligne, False, False, 0)
        cadre.pack_start(self.note("Prend effet au redémarrage. Le menu de démarrage propose toujours "
                                   "« Letag OS — dépannage » en cas de problème."), False, False, 0)
        if LIVE:
            self.mode.set_sensitive(False)
            bouton.set_sensitive(False)

        # --- Système -------------------------------------------------------
        cadre = self.section(boite, "Système")
        grille = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        boutons = [
            ("Mettre à jour le système", ["xfce4-terminal", "--hold", "-T", "Mises à jour", "-x", "letag-maj"]),
            ("Mesurer la mémoire", None),
            ("Gestionnaire des tâches", ["xfce4-taskmanager"]),
            ("Tous les paramètres", ["xfce4-settings-manager"]),
            ("Écrans", ["xfce4-display-settings"]),
            ("Réseau", ["nm-connection-editor"]),
        ]
        if LIVE:
            boutons.insert(0, ("Installer Letag OS…", ["letag-installer"]))
        for i, (texte, cmd) in enumerate(boutons):
            b = Gtk.Button(label=texte)
            if cmd is None:
                b.connect("clicked", self.mesurer)
            else:
                b.connect("clicked", lambda _b, c=cmd: lancer(c))
            grille.attach(b, i % 2, i // 2, 1, 1)
        cadre.pack_start(grille, False, False, 0)

        # --- À propos ------------------------------------------------------
        cadre = self.section(boite, "À propos de cet ordinateur")
        cpu, ram, gpu, pilote = info_materiel()
        version = "Letag OS"
        try:
            with open("/etc/letag-release") as f:
                version = f.read().strip()
        except OSError:
            pass
        for cle, val in (("Système", version + (" (session live)" if LIVE else "")),
                         ("Processeur", cpu), ("Mémoire", "%d Mo" % ram),
                         ("Carte graphique", gpu), ("Pilote actif", pilote)):
            l = Gtk.Label(xalign=0, selectable=True)
            l.set_line_wrap(True)
            l.set_markup("<b>%s :</b> %s" % (GLib.markup_escape_text(cle), GLib.markup_escape_text(val)))
            cadre.pack_start(l, False, False, 0)

    @staticmethod
    def note(texte):
        l = Gtk.Label(label=texte, xalign=0)
        l.set_line_wrap(True)
        l.get_style_context().add_class("dim-label")
        return l

    @staticmethod
    def section(parent, titre):
        etiquette = Gtk.Label(xalign=0)
        etiquette.set_markup("<b>%s</b>" % GLib.markup_escape_text(titre))
        parent.pack_start(etiquette, False, False, 0)
        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        boite.set_margin_start(12)
        parent.pack_start(boite, False, False, 0)
        return boite

    def changer_theme(self, _w):
        subprocess.run(["letag-theme", "clair" if self.clair.get_active() else "sombre"])

    def changer_effets(self, _w):
        subprocess.run(["letag-effets", "minimal" if self.minimal.get_active() else "equilibre"])

    def changer_affichage(self, _w):
        mode = self.mode.get_active_id()
        r = subprocess.run(["pkexec", "/usr/local/bin/letag-graphique", mode],
                           capture_output=True, text=True)
        self.message(Gtk.MessageType.INFO if r.returncode == 0 else Gtk.MessageType.ERROR,
                     "Mode d'affichage" if r.returncode == 0 else "Échec",
                     (r.stdout + r.stderr).strip()[-1500:] or "Annulé.")

    def mesurer(self, _w):
        self.message(Gtk.MessageType.INFO, "Mesure de la mémoire", sortie(["letag-mesure"]), mono=True)

    def message(self, genre, titre, texte, mono=False):
        d = Gtk.MessageDialog(transient_for=self, message_type=genre,
                              buttons=Gtk.ButtonsType.CLOSE, text=titre)
        zone = d.get_message_area()
        l = Gtk.Label(xalign=0, selectable=True)
        if mono:
            l.set_markup("<tt>%s</tt>" % GLib.markup_escape_text(texte))
        else:
            l.set_text(texte)
            l.set_line_wrap(True)
        zone.pack_start(l, False, False, 0)
        l.show()
        d.run()
        d.destroy()


if __name__ == "__main__":
    fen = Centre()
    fen.connect("destroy", Gtk.main_quit)
    fen.show_all()
    Gtk.main()
